# ─── LLM Provider API Keys ────────────────────────────────────────────────────
# Add at least one. ASTRA works in simulated mode if none are set.

GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
XAI_API_KEY=your_xai_api_key_here
DASHSCOPE_API_KEY=your_dashscope_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ─── Google Vertex AI (optional, no API key required) ─────────────────────────
# Uses Application Default Credentials. Run once: gcloud auth application-default login
# Then set your GCP project ID below.

VERTEX_PROJECT=your_gcp_project_id
VERTEX_LOCATION=us-central1

# ─── Default Provider ─────────────────────────────────────────────────────────
# Production: codex_cli | claude_cli | agy_cli
# Optional APIs: gemini | anthropic | openai | vertexai | deepseek | xai | qwen
#               mistral | codestral | groq | perplexity
# If unset, ASTRA picks the first configured provider automatically.

ASTRA_PROVIDER=codex_cli
# Production default. `quota-optimized` is an explicit benchmark/experiment
# profile and must not be used for broad paper or research-program audits.
ASTRA_ARCHITECTURE_PROFILE=full

# ─── Per-Phase Providers (optional) ───────────────────────────────────────────
# Override which provider handles each phase. Falls back to ASTRA_PROVIDER.

ASTRA_CONJECTURE_PROVIDER=codex_cli,agy_cli
ASTRA_TRANSLATOR_PROVIDER=claude_cli
ASTRA_REVIEWER_PROVIDER=codex_cli
ASTRA_ANALYST_PROVIDER=codex_cli
ASTRA_NAVIGATOR_PROVIDER=agy_cli
ASTRA_SYNTH_PROVIDER=codex_cli

# Recommended production model selection (subscription CLIs, no model API keys).
ASTRA_CLAUDE_MODELS=claude-opus-4-8,sonnet
ASTRA_CODEX_MODELS=gpt-5.6-sol
ASTRA_CODEX_REASONING=xhigh
ASTRA_AGY_MODELS=gemini-3.1-pro-high,gemini-3.5-flash-high
ASTRA_AGY_EFFORT=high
ASTRA_TRANSLATOR_MODELS=claude-opus-4-8,sonnet
# Per-call budget for the translator. Without this every phase inherits
# ASTRA_CLI_TIMEOUT (240 s), which astra_tool.py already warns is too tight for
# the long physics validators this phase writes. Measured 2026-08-13: three
# quality cases spent 250-438 s in translation or bounded repair and would have
# been killed at 240 s; raising the ceiling converted two dead cycles into
# correct verdicts. See docs/evidence/ASTRA2_TRANSLATOR_TIMEOUT_20260813.md.
#
# COUPLED WITH THE WHOLE-CYCLE BUDGET. A synchronous cycle defaults to 1500 s
# (astra_tool.py: cycle_timeout_seconds or 1500) minus a 60 s return buffer,
# so 1440 s must cover every phase. With the claude-opus-4-8,sonnet ladder a
# single translation can consume 2 x 480 = 960 s of that, starving review,
# repair, oracle and audit: measured 2026-08-13, six of twelve repeated cycles
# died on the whole-cycle wall rather than on any phase ceiling. Raise this
# only together with an explicit cycle_timeout_seconds for heavy cases.
# See docs/evidence/ASTRA2_REVIEWER_REPEATS_20260813.md.
ASTRA_TRANSLATOR_TIMEOUT=480
ASTRA_CODE_REVIEW=1
ASTRA_REVIEW_MAX_REVISIONS=1
ASTRA_NAVIGATE_AFTER_CYCLE=1
# Production validator repair: deterministic local fixes + one bounded model patch.
# Set ASTRA_VALIDATOR_REPAIR_VNEXT=0 only for a frozen classic baseline.
ASTRA_VALIDATOR_REPAIR_VNEXT=1
ASTRA_VALIDATOR_REPAIR_STRATEGY=local-patch
ASTRA_VNEXT_MODEL_PATCH_MAX_REVISIONS=1
# Cross-process resource policy. Full cycles share the same subscription
# accounts and are serialized; independent local validators/benchmarks use the
# detected CPU capacity unless ASTRA_LOCAL_WORKERS is set explicitly.
ASTRA_MAX_CONCURRENT_CYCLES=1
# ASTRA_LOCAL_WORKERS=4

# ─── Remote Validation Oracle (optional) ─────────────────────────────────────
